#include <winver.h>

// Informações que aparecem no gerenciador de tarefas
// e nas propriedades do arquivo.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,5,0
 PRODUCTVERSION 0,1,5,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "FileDescription",  "FPS Booster"
            VALUE "FileVersion",      "0.1.5"
            VALUE "InternalName",     "fpsbooster"
            VALUE "OriginalFilename", "fpsbooster.exe"
            VALUE "ProductName",      "FPS Booster"
            VALUE "ProductVersion",   "alpha v0.1.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END